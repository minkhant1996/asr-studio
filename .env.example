# Hosting settings read by ./serve.sh (copy to .env). The backend's own settings live in backend/.env.

# Local bind address and port for the single-origin server (built frontend + API).
HOST=127.0.0.1
PORT=8767

# Public ngrok domain. Leave empty for a random ngrok URL, or set TUNNEL=0 to serve locally only.
TUNNEL=1
DOMAIN=

# Basic auth enforced at the ngrok edge; both empty = open to anyone with the link.
BASIC_AUTH_USER=
BASIC_AUTH_PASS=
